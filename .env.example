# نمونه متغیرهای محیطی — پروژه «هوشمندسازی مطب»
#
# این فایل در مخزن هست و باید باشد. مقدار واقعی را اینجا ننویسید.
# هر عضو یک کپی به نام .env.local بسازد و مقادیر را از مدیر پروژه بگیرد:
#     copy .env.example .env.local
# فایل .env.local در .gitignore مسدود است و هرگز وارد مخزن نمی‌شود.

# --- Supabase ---
# نشانی پروژه و کلید عمومی: در مرورگر هم استفاده می‌شوند، با RLS محافظت می‌شوند.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# کلید مدیریتی: همه قفل‌ها را باز می‌کند.
# فقط در کد سمت سرور. هرگز با پیشوند NEXT_PUBLIC و هرگز در پیام یا اسکرین‌شات.
SUPABASE_SERVICE_ROLE_KEY=

# --- حساب‌های آزمایشی (ساختگی، برای آزمون‌های خودکار) ---
TEST_DOCTOR_EMAIL=
TEST_DOCTOR_PASSWORD=
TEST_SECRETARY_EMAIL=
TEST_SECRETARY_PASSWORD=

# --- ربات پیام‌رسان (از کار p2-11 به بعد) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- زمان‌بندی یادآوری روزانه (از کار p2-13 به بعد) ---
CRON_SECRET=
